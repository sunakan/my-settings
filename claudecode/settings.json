{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_METRICS_INCLUDE_VERSION": "true",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otlp.nr-data.net",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_RAW_API_BODIES": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "1",
    "OTEL_RESOURCE_ATTRIBUTES": "service.name=claude-code,host.name=user01-mac"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "_description: クレデンシャルファイル操作を全て禁止",
      "Read(.credential*)",
      "Edit(.credential*)",
      "Read(*.credential*)",
      "Edit(*.credential*)",
      "Read(**/.credential*)",
      "Edit(**/.credential*)",
      "Read(**/*.credential*)",
      "Edit(**/*.credential*)",
      "Read(.secret*)",
      "Edit(.secret*)",
      "Read(*.secret*)",
      "Edit(*.secret*)",
      "Read(**/.secret*)",
      "Edit(**/.secret*)",
      "Read(**/*.secret*)",
      "Edit(**/*.secret*)",
      "_description: .env系ファイルの操作を全て禁止(.envrcは止めない)",
      "Read(.env)",
      "Edit(.env)",
      "Read(.env.*)",
      "Edit(.env.*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "_description: Railsのクレデンシャル系ファイルの操作を全て禁止",
      "Read(master.key*)",
      "Edit(master.key*)",
      "Read(**/master.key*)",
      "Edit(**/master.key*)",
      "_description: 特定のディレクトリ以下の操作を全て禁止",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(**/.aws/**)",
      "Edit(**/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(credentials/**)",
      "Edit(credentials/**)",
      "Read(**/credentials/**)",
      "Edit(**/credentials/**)",
      "Read(log/**)",
      "Edit(log/**)",
      "Read(**/log/**)",
      "Edit(**/log/**)",
      "Read(.git/**)",
      "Edit(.git/**)",
      "Read(**/.git/**)",
      "Edit(**/.git/**)",
      "_description: Claude Code自身の認証情報・会話ログを保護",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Read(~/.claude/history.jsonl)",
      "Edit(~/.claude/history.jsonl)",
      "_description: 個別",
      "_description: gitの参照以外を禁止",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git -C *)",
      "Bash(git stage *)",
      "Bash(git commit -a *)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "_description: ghの参照以外を禁止(PRへコメントやissue作成・コメントは許可)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh issue close *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo edit *)",
      "Bash(gh workflow run *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh token *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-sensitive-files.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-git-staging.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-on-stop.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "crit@crit": true
  },
  "language": "日本語",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "mcpServers": {}
}

{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_METRICS_INCLUDE_VERSION": "true",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otlp.nr-data.net",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_RAW_API_BODIES": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "1",
    "OTEL_RESOURCE_ATTRIBUTES": "service.name=claude-code,host.name=user01-mac"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "_description: クレデンシャルファイル操作を全て禁止",
      "Read(.credential*)", "Edit(.credential*)", "Write(.credential*)",
      "Read(*.credential*)", "Edit(*.credential*)", "Write(*.credential*)",
      "Read(**/.credential*)", "Edit(**/.credential*)", "Write(**/.credential*)",
      "Read(**/*.credential*)", "Edit(**/*.credential*)", "Write(**/*.credential*)",

      "Read(.secret*)", "Edit(.secret*)", "Write(.secret*)",
      "Read(*.secret*)", "Edit(*.secret*)", "Write(*.secret*)",
      "Read(**/.secret*)", "Edit(**/.secret*)", "Write(**/.secret*)",
      "Read(**/*.secret*)", "Edit(**/*.secret*)", "Write(**/*.secret*)",

      "_description: .env系ファイルの操作を全て禁止(.envrcは止めない)",
      "Read(.env)", "Edit(.env)", "Write(.env)",
      "Read(.env.*)", "Edit(.env.*)", "Write(.env.*)",
      "Read(**/.env)", "Edit(**/.env)", "Write(**/.env)",
      "Read(**/.env.*)", "Edit(**/.env.*)", "Write(**/.env.*)",

      "_description: Railsのクレデンシャル系ファイルの操作を全て禁止",
      "Read(master.key*)", "Edit(master.key*)", "Write(master.key*)",
      "Read(**/master.key*)", "Edit(**/master.key*)", "Write(**/master.key*)",

      "_description: 特定のディレクトリ以下の操作を全て禁止",
      "Read(~/.aws/**)", "Edit(~/.aws/**)", "Write(~/.aws/**)",
      "Read(**/.aws/**)", "Edit(**/.aws/**)", "Write(**/.aws/**)",
      "Read(~/.ssh/**)", "Edit(~/.ssh/**)", "Write(~/.ssh/**)",
      "Read(secrets/**)", "Edit(secrets/**)", "Write(secrets/**)",
      "Read(**/secrets/**)", "Edit(**/secrets/**)", "Write(**/secrets/**)",
      "Read(credentials/**)", "Edit(credentials/**)", "Write(credentials/**)",
      "Read(**/credentials/**)", "Edit(**/credentials/**)", "Write(**/credentials/**)",
      "Read(log/**)", "Edit(log/**)", "Write(log/**)",
      "Read(**/log/**)", "Edit(**/log/**)", "Write(**/log/**)",
      "Read(.git/**)", "Edit(.git/**)", "Write(.git/**)",
      "Read(**/.git/**)", "Edit(**/.git/**)", "Write(**/.git/**)",

      "_description: Claude Code自身の認証情報・会話ログを保護",
      "Read(~/.claude.json)", "Edit(~/.claude.json)", "Write(~/.claude.json)",
      "Read(~/.claude/history.jsonl)", "Edit(~/.claude/history.jsonl)", "Write(~/.claude/history.jsonl)",

      "_description: 個別",
      "Write(.terraformrc)",
      "Write(.aws_config)",
      "_description: gitの参照以外を禁止",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git stage *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "_description: ghの参照以外を禁止(PRへコメントやissue作成・コメントは許可)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh issue close *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo edit *)",
      "Bash(gh workflow run *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh token *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-sensitive-files.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-on-stop.sh"
          }
        ]
      }
    ]
  },
  "language": "日本語",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (ローカル)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        // "利用する時のキー": { "name": "正式名" }
        // 正式名の取得curl
        // curl -s http://localhost:11434/v1/models | jq '.data[].id'
        "batiai/qwen3.6-27b:q6": { "name": "batiai/qwen3.6-27b:q6" }
      }
    }
  },
  // デフォルトのモデル
  // modelの値は"provider名/modelsのキー"
  "model": "ollama/batiai/qwen3.6-27b:q6",
  "modelConfig": {
    "ollama/batiai/qwen3.6-27b:q6": {
      "temperature": 0.6    }
  }
}
